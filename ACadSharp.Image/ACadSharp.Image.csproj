<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<TargetFrameworks Condition="'$(PublishAot)' != 'true'">net6.0;net8.0;net10.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(PublishAot)' == 'true'">net10.0</TargetFrameworks>
		<BaseIntermediateOutputPath Condition="'$(PublishAot)' == 'true'">obj\publish-aot\</BaseIntermediateOutputPath>
		<IsPackable>true</IsPackable>
		<PackageId>ACadSharp.Image</PackageId>
		<Title>ACadSharp.Image</Title>
		<Description>Raster and SVG exporter for ACadSharp DXF and DWG documents.</Description>
		<PackageTags>acadsharp;cad;dxf;dwg;imagesharp;svg;rendering</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	</PropertyGroup>

	<ItemGroup>
		<!--
			ImageSharp 3.2.0 is the last line that supports .NET 6 and has no patched 3.x release, so NuGet audit
			reports advisories that cannot be fixed without dropping net6.0. The net8.0 and net10.0 builds use
			ImageSharp 4.1.3 and are not affected. Suppress only these advisories so new ones still surface.
		-->
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
		<PackageReference Include="ACadSharp" />
		<PackageReference Include="SixLabors.Fonts" />
		<PackageReference Include="SixLabors.ImageSharp" />
		<PackageReference Include="SixLabors.ImageSharp.Drawing" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ACadSharp.Image.Tests" />
	</ItemGroup>

</Project>
