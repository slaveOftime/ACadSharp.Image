<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="ACadSharp" Version="3.8.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!--
    SixLabors 4.x (ImageSharp) and 3.x (Fonts, Drawing) require .NET 8 or later.
    net6.0 stays on the last .NET 6 compatible line: ImageSharp 3.2.0, Fonts 2.2.0, Drawing 2.2.0.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageVersion Include="SixLabors.Fonts" Version="2.2.0" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.2.0" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net6.0'">
    <PackageVersion Include="SixLabors.Fonts" Version="3.2.0" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="3.1.3" />
  </ItemGroup>
</Project>
